---
// /research/doctorate/ — Докторантура. Контент взято з fcst.kai.edu.ua/аспірантура-докторантура/.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const requirements = [
  "Ступінь доктора філософії (PhD) або кандидата наук, отриманий не менш як три роки тому.",
  "Наявність суттєвих наукових результатів і розробок, рекомендованих до захисту як докторська дисертація.",
  "Згода доктора наук — наукового консультанта — здійснювати наукове консультування.",
  "Позитивний висновок кафедри університету за відповідною спеціальністю.",
];

const benefits = [
  { icon: "🔬", title: "Власне дослідження", text: "Формуєте принципово новий науковий напрям або вирішуєте важливу наукову проблему, що суттєво розвиває обрану галузь знань." },
  { icon: "🏛️", title: "Інфраструктура університету", text: "Доступ до лабораторій, обладнання, міжнародних баз даних, наукових фондів та грантової підтримки НАКУ «ХАІ»." },
  { icon: "🤝", title: "Наукова спільнота", text: "Тісна взаємодія з науковцями факультету, участь у конференціях, симпозіумах, міжнародних проєктах і публікації у провідних виданнях." },
  { icon: "🎓", title: "Вищий науковий ступінь", text: "Захист дисертації дає змогу здобути ступінь доктора наук — найвищу кваліфікаційну сходинку в українській науці." },
];

const specialties = [
  { code: "113", name: "Прикладна математика" },
  { code: "121", name: "Інженерія програмного забезпечення" },
  { code: "122", name: "Комп'ютерні науки" },
  { code: "123", name: "Комп'ютерна інженерія" },
  { code: "125", name: "Кібербезпека" },
  { code: "126", name: "Інформаційні системи та технології" },
];
---
<Base
  title="Докторантура · ФКНТ"
  description="Підготовка докторів наук на факультеті комп'ютерних наук та технологій НАКУ «ХАІ»."
>
  <section class="wrap page">
    <Breadcrumbs items={[{ label: "Головна", href: "/" }, { label: "Наука", href: "/research/" }, { label: "Докторантура" }]} />
    <p class="eyebrow">Найвищий рівень наукової кваліфікації</p>
    <h1 class="display">Докторантура</h1>
    <p class="lead">
      Докторантура — форма підготовки наукових кадрів вищої кваліфікації для здобуття
      ступеня <strong>доктора наук</strong>. Вона орієнтована на вчених, котрі вже мають
      ступінь доктора філософії (PhD) та накопичили значний доробок для формування
      нового наукового напряму або вирішення масштабної наукової проблеми.
    </p>
  </section>

  <!-- Abstract illustration -->
  <section class="wrap hero-art" aria-hidden="true">
    <svg viewBox="0 0 900 260" xmlns="http://www.w3.org/2000/svg" class="art-svg">
      <defs>
        <linearGradient id="doc-g1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--deep)" stop-opacity=".15"/>
          <stop offset="100%" stop-color="var(--primary)" stop-opacity=".05"/>
        </linearGradient>
        <linearGradient id="doc-g2" x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--sky)" stop-opacity=".2"/>
          <stop offset="100%" stop-color="var(--deep)" stop-opacity=".08"/>
        </linearGradient>
      </defs>
      <!-- background blobs -->
      <ellipse cx="140" cy="140" rx="160" ry="110" fill="url(#doc-g1)"/>
      <ellipse cx="760" cy="120" rx="190" ry="120" fill="url(#doc-g2)"/>
      <!-- hex-like grid pattern -->
      {Array.from({length: 10}).map((_, i) =>
        Array.from({length: 4}).map((_, j) => (
          <polygon
            points={`${85+i*75+(j%2)*37},${35+j*58} ${97+i*75+(j%2)*37},${28+j*58} ${109+i*75+(j%2)*37},${35+j*58} ${109+i*75+(j%2)*37},${49+j*58} ${97+i*75+(j%2)*37},${56+j*58} ${85+i*75+(j%2)*37},${49+j*58}`}
            fill="none"
            stroke="var(--deep)"
            stroke-width="1"
            opacity={0.06 + i*0.004}
          />
        ))
      )}
      <!-- star / diamond centre -->
      <polygon points="450,60 470,125 540,130 475,168 492,235 450,200 408,235 425,168 360,130 430,125" fill="none" stroke="var(--sky)" stroke-width="1.2" opacity=".15"/>
      <circle cx="450" cy="130" r="22" fill="var(--deep)" opacity=".1"/>
      <circle cx="450" cy="130" r="10" fill="var(--primary)" opacity=".15"/>
      <!-- radiating lines -->
      <line x1="450" y1="60"  x2="450" y2="108" stroke="var(--primary)" stroke-width="1" opacity=".2"/>
      <line x1="450" y1="152" x2="450" y2="200" stroke="var(--primary)" stroke-width="1" opacity=".2"/>
      <line x1="360" y1="130" x2="405" y2="130" stroke="var(--primary)" stroke-width="1" opacity=".2"/>
      <line x1="495" y1="130" x2="540" y2="130" stroke="var(--primary)" stroke-width="1" opacity=".2"/>
      <!-- outer nodes -->
      <circle cx="160" cy="75"  r="7" fill="var(--deep)" opacity=".18"/>
      <circle cx="740" cy="85"  r="7" fill="var(--sky)" opacity=".18"/>
      <circle cx="175" cy="185" r="5" fill="var(--primary)" opacity=".16"/>
      <circle cx="720" cy="175" r="5" fill="var(--deep)" opacity=".16"/>
      <!-- connecting lines to outer nodes -->
      <line x1="160" y1="75"  x2="360" y2="130" stroke="var(--deep)" stroke-width=".8" opacity=".08"/>
      <line x1="740" y1="85"  x2="540" y2="130" stroke="var(--sky)" stroke-width=".8" opacity=".08"/>
      <line x1="175" y1="185" x2="360" y2="130" stroke="var(--primary)" stroke-width=".8" opacity=".08"/>
      <line x1="720" y1="175" x2="540" y2="130" stroke="var(--deep)" stroke-width=".8" opacity=".08"/>
      <!-- floating triangles -->
      <polygon points="70,55 88,85 52,85"  fill="var(--deep)" opacity=".07"/>
      <polygon points="830,45 848,75 812,75" fill="var(--sky)" opacity=".08"/>
      <polygon points="840,170 854,195 826,195" fill="var(--signal)" opacity=".2"/>
    </svg>
  </section>

  <section class="wrap section">
    <h2 class="display">Що таке докторантура</h2>
    <div class="two-col">
      <div>
        <p>
          Докторантура — це не навчальна програма в класичному розумінні, а цілеспрямована наукова
          робота над монографічним дослідженням. Строк перебування в докторантурі становить
          <strong>до 2 років</strong>. За цей час докторант готує докторську дисертацію під
          керівництвом наукового консультанта — доктора наук за відповідною спеціальністю.
        </p>
        <p>
          На відміну від аспірантури, докторантура не передбачає складання іспитів — вся
          діяльність зосереджена на завершенні дисертаційного дослідження та підготовці до захисту
          перед спеціалізованою вченою радою.
        </p>
      </div>
      <div class="aside-box">
        <p class="eyebrow">Строк навчання</p>
        <p class="big-num">2 роки</p>
        <p>Очна (денна) форма навчання. За необхідності термін може бути продовжений відповідно до законодавства.</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="display">Переваги для дослідника</h2>
    <div class="benefits">
      {benefits.map((b) => (
        <div class="benefit">
          <span class="benefit-icon">{b.icon}</span>
          <b>{b.title}</b>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <h2 class="display">Спеціальності</h2>
    <p>Підготовка в докторантурі ведеться за тими самими спеціальностями, що й в аспірантурі:</p>
    <div class="spec-grid">
      {specialties.map((s) => (
        <div class="spec-card">
          <span class="spec-code">{s.code}</span>
          <span class="spec-name">{s.name}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <h2 class="display">Вимоги до вступу</h2>
    <ul class="req-list">
      {requirements.map((r) => <li>{r}</li>)}
    </ul>
    <p class="note">
      Зарахування до докторантури здійснюється за конкурсом після розгляду документів
      та співбесіди з потенційним науковим консультантом.
    </p>
  </section>

  <section class="wrap section">
    <h2 class="display">Результат — доктор наук</h2>
    <p>
      Після успішного захисту дисертаційної роботи перед спеціалізованою вченою радою та
      рішення Атестаційної колегії МОН України здобувачеві присвоюється
      <strong>науковий ступінь доктора наук</strong> — найвища кваліфікаційна відзнака в
      українській системі освіти та науки. Це відкриває шлях до очолення кафедр, наукових
      лабораторій, участі у міжнародних дослідницьких консорціумах та залучення грантового
      фінансування найвищого рівня.
    </p>
  </section>

  <section class="wrap section cta-section">
    <h2 class="display">Готові зробити наступний крок?</h2>
    <p>Звертайтеся до наукового відділу факультету або безпосередньо до кафедри, яка відповідає вашому науковому напряму.</p>
    <div class="cta-btns">
      <a class="btn" href="/contacts/">Контакти факультету →</a>
      <a class="btn btn-outline" href="/research/phd/">Про аспірантуру →</a>
    </div>
  </section>
</Base>

<style>
.page { padding: 40px 24px 20px; }
h1 { color: var(--deep); font-size: clamp(2rem, 4vw, 2.8rem); margin: 12px 0 0; }
h2.display { color: var(--deep); font-size: clamp(1.4rem, 3vw, 1.8rem); }

.section { padding: 40px 24px; }

.hero-art { padding-block: 0; }
.art-svg  { width: 100%; max-height: 260px; display: block; }

.lead { margin-bottom: 0; }

/* Two-col */
.two-col { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: start; margin-top: 1.5rem; }
@media (max-width: 640px) { .two-col { grid-template-columns: 1fr; } }
.aside-box {
  min-width: 200px;
  padding: 1.5rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--tint);
  text-align: center;
}
.big-num { font-size: 3rem; font-weight: 800; line-height: 1; margin: .25rem 0 .5rem; color: var(--primary); }

/* Benefits */
.benefits {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 1.25rem;
  margin-top: 1.5rem;
}
.benefit {
  padding: 1.25rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--tint);
}
.benefit-icon { font-size: 1.8rem; display: block; margin-bottom: .6rem; }
.benefit b { display: block; margin-bottom: .4rem; color: var(--deep); }
.benefit p { margin: 0; font-size: .93rem; line-height: 1.45; color: var(--muted); }

/* Specialty cards */
.spec-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1rem;
  margin-top: 1.5rem;
}
.spec-card {
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .9rem 1rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--tint);
}
.spec-code { font-size: 1.1rem; font-weight: 700; color: var(--primary); min-width: 2.5rem; }
.spec-name { font-size: .95rem; line-height: 1.35; }

/* Requirements */
.req-list { padding-left: 1.4rem; margin-top: 1rem; }
.req-list li { margin-bottom: .65rem; line-height: 1.55; }
.note { font-size: .93rem; color: var(--muted); margin-top: 1rem; }

/* CTA */
.cta-section { text-align: center; }
.cta-section p { color: var(--muted); max-width: 60ch; margin-inline: auto; margin-bottom: 1.5rem; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-weight: 800;
  padding: 13px 24px;
  border-radius: var(--radius-sm);
  background: transparent;
  border: 2px solid var(--primary);
  color: var(--primary);
  transition: background .18s;
}
.btn-outline:hover { background: color-mix(in srgb, var(--primary) 10%, transparent); }
</style>
