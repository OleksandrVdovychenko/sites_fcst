---
// /students/parttime/ — заочна форма навчання. Графік освітнього процесу вже є
// на окремій сторінці /students/parttime/grafik/ (реальні дані); решта пунктів —
// заглушки до появи контенту. Прибрати "stub" стан, коли з'явиться реальний контент.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBand from "../../../components/CtaBand.astro";
import rozklad from "../../../data/parttime-rozklad.json";

const items = [
  { id: "spysky-hrup", title: "Списки груп", text: "Списки груп заочної форми готуються до публікації." },
  { id: "dokumenty", title: "Накази, положення, інструкції", text: "Накази та положення, що стосуються заочної форми навчання, готуються до публікації." },
];

// "dd.mm.yyyy" → "28 вересня, понеділок" (UTC, щоб не залежати від часового поясу збірки).
const fmtDay = (s: string) => {
  const [d, m, y] = s.split(".").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  const date = dt.toLocaleDateString("uk-UA", { day: "numeric", month: "long", timeZone: "UTC" });
  const wd = dt.toLocaleDateString("uk-UA", { weekday: "long", timeZone: "UTC" });
  return `${date}, ${wd}`;
};
---
<Base title="Заочна форма навчання · Здобувачам · ФКНТ" description="Графік освітнього процесу, розклад та документи для студентів заочної форми навчання ФКНТ.">
  <section class="wrap page">
    <Breadcrumbs items={[{ label: "Головна", href: "/" }, { label: "Здобувачам", href: "/students/" }, { label: "Заочна форма навчання" }]} />
    <p class="eyebrow">Здобувачам · заочна форма</p>
    <h1 class="display">Заочна форма навчання</h1>
    <p class="lead">
      Графік освітнього процесу за групами вже доступний. Решта розділу наповнюється —
      за актуальною інформацією звертайтеся до деканату.
    </p>
    <a class="btn-outline" href="/students/parttime/grafik/">Графік освітнього процесу за групою →</a>
  </section>

  <section class="wrap section">
    <div class="stub-grid">
      {items.map((it) => (
        <div class="stub-card" id={it.id}>
          <h2>{it.title}</h2>
          <p>{it.text}</p>
          <a class="stub-link" href="/contacts/">Уточнити в деканаті →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="rz-card" id="rozklad-zanyat">
      <p class="eyebrow">Заочна форма навчання · {rozklad.course} курс, {rozklad.degree.toLowerCase()}</p>
      <h2 class="display">Розклад занять — екзаменаційна сесія</h2>

      <div class="deadline">
        <b>28 вересня – 2 жовтня 2026</b>
        <span>розклад екзаменаційної сесії за групами</span>
      </div>

      <p class="rz-hint">Оберіть свою групу — нижче з'явиться розклад по днях. Коди доступу — до відповідних курсів у Google Classroom.</p>

      <div class="rz-pills" id="rz-pills" role="group" aria-label="Група" hidden>
        {rozklad.groups.map((g, i) => (
          <button type="button" class="rz-pill" data-group={g.code} aria-pressed={i === 0 ? "true" : "false"}>{g.code}</button>
        ))}
      </div>

      {rozklad.groups.map((g) => (
        <div class="rz-group" data-group={g.code}>
          <p class="rz-meta"><b>{g.code}</b> · {g.specialty} · ОП «{g.program}»</p>
          {g.days.map((day) => (
            <div class="rz-day">
              <h3>{fmtDay(day.date)}</h3>
              <div class="rz-table-wrap">
                <table>
                  <thead>
                    <tr><th>Пара</th><th>Дисципліна, викладач</th><th>Вид занять</th><th>Код Google Classroom</th></tr>
                  </thead>
                  <tbody>
                    {day.lessons.map((l) => (
                      <tr>
                        <td class="c-pair">{l.pair}</td>
                        <td><span class="c-subject">{l.subject}</span><span class="c-teacher">{l.teacher}</span></td>
                        <td class="c-type">{l.type}</td>
                        <td class="c-code"><code>{l.code}</code></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      ))}

      <p class="rz-foot">Затверджено: {rozklad.approvedBy}. Погоджено: {rozklad.agreedBy}. {rozklad.deanDeputy}.</p>
      <a class="btn-outline rz-dl" href={encodeURI(rozklad.sourceFile)} target="_blank" rel="noopener">Завантажити оригінал розкладу (PDF) →</a>
    </div>
  </section>

  <CtaBand title="Потрібна допомога?" href="/contacts/" label="Контакти деканату →" />
</Base>

<style>
.page { padding: 40px 24px 20px; }
h1 { color: var(--deep); font-size: clamp(2rem, 4vw, 2.8rem); margin: 12px 0 0; }
.lead { margin-top: 14px; max-width: 62ch; }

.btn-outline {
  display: inline-flex; align-items: center; gap: 9px; font-weight: 800;
  padding: 13px 24px; margin-top: 20px; border-radius: var(--radius-sm);
  background: transparent; border: 2px solid var(--primary); color: var(--primary);
  text-decoration: none; transition: background .18s;
}
.btn-outline:hover { background: color-mix(in srgb, var(--primary) 10%, transparent); }

.section { padding: 20px 24px 40px; }

.stub-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
.stub-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 22px;
  scroll-margin-top: 90px;
}
.stub-card h2 { color: var(--deep); font-size: 1.05rem; margin: 0 0 10px; }
.stub-card p { color: var(--muted); font-size: .92rem; margin: 0 0 14px; }
.stub-link { font-weight: 700; color: var(--primary); text-decoration: none; font-size: .9rem; }
.stub-link:hover { color: var(--deep); }

.rz-card {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
  padding: 32px; scroll-margin-top: 90px;
}
.rz-card h2.display { color: var(--deep); font-size: clamp(1.4rem, 3vw, 1.8rem); margin: 10px 0 20px; }
.deadline {
  display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
  background: var(--tint); border-left: 4px solid var(--signal); border-radius: 0 8px 8px 0;
  padding: 12px 16px; margin: 0 0 18px;
}
.deadline b { color: var(--deep); font-size: 1rem; }
.deadline span { color: var(--muted); font-size: .88rem; }
.rz-hint { color: #404869; font-size: .95rem; line-height: 1.6; margin: 0 0 16px; max-width: 70ch; }

.rz-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.rz-pills[hidden] { display: none; }
.rz-pill {
  font: inherit; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .86rem; font-weight: 700;
  color: #39406a; background: var(--tint); border: 1px solid var(--line);
  padding: 8px 14px; border-radius: 20px; cursor: pointer;
}
.rz-pill:hover { border-color: var(--sky); }
.rz-pill[aria-pressed="true"] { background: var(--primary); border-color: var(--primary); color: #fff; }

.rz-meta { color: var(--muted); font-size: .9rem; margin: 0 0 14px; }
.rz-meta b { color: var(--deep); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
.rz-group[hidden] { display: none; }
.rz-group + .rz-group { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); }

.rz-day { margin-bottom: 18px; }
.rz-day h3 { color: var(--deep); font-size: .95rem; margin: 0 0 8px; text-transform: capitalize; }
.rz-table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-sm); }
.rz-table-wrap table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.rz-table-wrap th {
  text-align: left; background: var(--tint); color: var(--deep); font-size: .72rem; font-weight: 800;
  letter-spacing: .06em; text-transform: uppercase; padding: 9px 12px; white-space: nowrap;
}
.rz-table-wrap td { padding: 10px 12px; border-top: 1px solid var(--line); vertical-align: top; color: #404869; }
.c-pair { font-weight: 800; color: var(--deep); white-space: nowrap; }
.c-subject { display: block; color: var(--ink); font-weight: 600; }
.c-teacher { display: block; color: var(--muted); font-size: .84rem; margin-top: 2px; }
.c-type { white-space: nowrap; }
.c-code code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .86rem; background: var(--tint); padding: 2px 7px; border-radius: 5px; color: var(--deep); }

.rz-foot { color: var(--muted); font-size: .82rem; line-height: 1.55; margin: 20px 0 0; }
.rz-dl { margin-top: 16px; }
</style>

<script>
  const pills = document.getElementById("rz-pills");
  if (pills) {
    const groups = Array.from(document.querySelectorAll<HTMLElement>(".rz-group"));
    const buttons = Array.from(pills.querySelectorAll<HTMLButtonElement>(".rz-pill"));
    const show = (code: string) => {
      groups.forEach((g) => { g.hidden = g.dataset.group !== code; });
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.group === code)));
    };
    // Без JS усі групи видно підряд; з JS — по одній, вибір за пігулкою.
    pills.hidden = false;
    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.group!)));
    show(buttons[0].dataset.group!);
  }
</script>
