---
// /students/ — хаб для здобувачів (студентів, аспірантів, докторантів).
// Навігація по основним розділам, посилання на підсторінки.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";

const sections = [
  {
    title: "Денна форма навчання",
    icon: "📚",
    links: [
      { label: "Графік освітнього процесу", href: "/students/fulltime/#grafik" },
      { label: "Розклад занять", href: "/students/fulltime/#rozklad-zanyat" },
      { label: "Розклад екзаменів", href: "/students/fulltime/#rozklad-ekzameniv" },
      { label: "Графік складання академічної заборгованості", href: "/students/fulltime/#zaborhovanist" },
      { label: "Поновлення", href: "/students/fulltime/#ponovlennya" },
    ],
  },
  {
    title: "Заочна форма навчання",
    icon: "🌙",
    links: [
      { label: "Графік освітнього процесу", href: "/students/parttime/grafik/" },
      { label: "Списки груп", href: "/students/parttime/#spysky-hrup" },
      { label: "Розклад занять", href: "/students/parttime/#rozklad-zanyat" },
      { label: "Накази, положення, інструкції", href: "/students/parttime/#dokumenty" },
    ],
  },
  {
    title: "Підготовка кадрів (PhD)",
    icon: "🎓",
    links: [
      { label: "Розклад занять", href: "/students/phd/#rozklad-zanyat" },
      { label: "Атестація здобувачів", href: "/students/phd/#atestatsiya" },
      { label: "Академічна доброчесність", href: "/students/phd/#dobrochesnist" },
      { label: "Процедури захисту", href: "/students/phd/#zakhyst" },
      { label: "Корисно для науковців", href: "/students/phd/#korysno" },
    ],
  },
  {
    title: "Дистанційна форма навчання",
    icon: "💻",
    links: [
      { label: "Інформація та розклад", href: "/students/distance/" },
      { label: "Дозвілля", href: "/students/leisure/" },
    ],
  },
];

// Розділ ще наповнюється — реального контенту (посилання на кабінети,
// порядок замовлення довідок тощо) поки немає, тому кожен пункт має власний
// id (ціль анкорних посилань з мегаменю) і коротку заглушку замість опису.
// Прибрати "stub" стан по кожному пункту, коли з'явиться реальний контент.
const services = [
  { id: "osvitni-prohramy", label: "Освітні програми", text: "Перелік освітніх програм ФКНТ готується до публікації." },
  { id: "digital-university", label: "Кабінет студента Digital University", text: "Посилання на кабінет студента уточнюється." },
  { id: "dovidky", label: "Замовлення довідок, дублікатів", text: "Порядок замовлення довідок про навчання уточнюється." },
  { id: "pidsumkova-atestatsiya", label: "Підсумкова атестація", text: "Інформація про підсумкову атестацію готується до публікації." },
  { id: "trayektoriya", label: "Індивідуальна освітня траєкторія", text: "Порядок формування індивідуальної освітньої траєкторії уточнюється." },
  { id: "classroom", label: "Коди Google Classroom", text: "Коди для приєднання до класів уточнюйте на кафедрі." },
  { id: "reityng", label: "Рейтинг успішності", text: "Інформація про рейтинг успішності готується до публікації." },
  { id: "shablony-zayav", label: "Шаблони заяв", text: "Шаблони типових заяв готуються до публікації." },
];
---

<Base title="Здобувачам · ФКНТ" description="Інформація для студентів: розклади, графіки, контакти та важлива інформація для здобувачів ФКНТ.">
  <section class="wrap page">
    <Breadcrumbs items={[{ label: "Головна", href: "/" }, { label: "Здобувачам" }]} />

    <h1 class="display">Здобувачам</h1>
    <p class="lead">
      Все, що потрібно знати студентам, аспірантам та докторантам: розклади занять, графіки семестрів, 
      важлива інформація та послуги.
    </p>
  </section>

  <!-- ФОРМИ НАВЧАННЯ -->
  <section class="wrap cards-section">
    <h2 class="display">Форми навчання</h2>
    <div class="cards-grid">
      {sections.map((section) => (
        <div class="card">
          <div class="card-head">
            <span class="icon">{section.icon}</span>
            <h3>{section.title}</h3>
          </div>
          <ul class="card-links">
            {section.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ПОСЛУГИ -->
  <section class="wrap services-section">
    <div class="services-head">
      <div>
        <p class="eyebrow">Важливе</p>
        <h2 class="display">Послуги та інформація</h2>
      </div>
    </div>
    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card" id={service.id}>
          <h3>{service.label}</h3>
          <p>{service.text}</p>
          <a class="service-link" href="/contacts/">
            Уточнити в деканаті
            <span class="arrow">→</span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CtaBand title="Потрібна допомога?" href="/contacts/" label="Контакти деканату →" />
</Base>

<style>
  .page {
    padding: 40px 24px 20px;
  }

  h1 {
    color: var(--deep);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 16px;
  }

  .lead {
    margin-top: 0;
    max-width: 56ch;
  }

  .cards-section {
    padding: 40px 24px;
  }

  .cards-section > h2 {
    color: var(--deep);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin-bottom: 28px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .icon {
    font-size: 2rem;
  }

  .card-head h3 {
    color: var(--deep);
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.3;
  }

  .card-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-links li a {
    display: block;
    padding: 8px 0;
    font-size: 0.95rem;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .card-links li a:hover {
    color: var(--deep);
    border-bottom-color: var(--primary);
  }

  .services-section {
    padding: 40px 24px;
    background: var(--tint);
  }

  .services-head {
    margin-bottom: 28px;
  }

  .services-head h2 {
    color: var(--deep);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin-top: 8px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .service-card {
    padding: 20px;
    background: #fff;
    border-radius: 8px;
    border: 1px solid var(--line);
    scroll-margin-top: 90px;
  }

  .service-card h3 {
    color: var(--deep);
    font-size: 1rem;
    margin: 0 0 8px;
  }

  .service-card p {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 12px;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--primary);
    text-decoration: none;
  }

  .service-link:hover {
    color: var(--deep);
  }

  .arrow {
    margin-left: 6px;
    font-size: 0.9rem;
  }

  .services-head .eyebrow {
    color: var(--signal-2);
  }

  @media (max-width: 600px) {
    .page {
      padding: 32px 16px 16px;
    }

    h1 {
      font-size: 1.8rem;
      margin-bottom: 12px;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

  }
</style>
