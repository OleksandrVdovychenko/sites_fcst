---
// /students/ — хаб для здобувачів (студентів, аспірантів, докторантів).
// Навігація по основним розділам, посилання на підсторінки.
import Base from "../../layouts/Base.astro";

const sections = [
  {
    title: "Денна форма навчання",
    icon: "📚",
    links: [
      { label: "Графік освітнього процесу", href: "/students/fulltime/#grafik" },
      { label: "Розклад занять", href: "/students/fulltime/#rozklad-zanyat" },
      { label: "Розклад екзаменів", href: "/students/fulltime/#rozklad-ekzameniv" },
      { label: "Графік складання академічної заборгованості", href: "/students/fulltime/#zaborhovanist" },
      { label: "Поновлення", href: "/students/fulltime/#ponovlennya" },
    ],
  },
  {
    title: "Заочна форма навчання",
    icon: "🌙",
    links: [
      { label: "Графік освітнього процесу", href: "/students/parttime/grafik/" },
      { label: "Списки груп", href: "/students/parttime/#spysky-hrup" },
      { label: "Розклад занять", href: "/students/parttime/#rozklad-zanyat" },
      { label: "Накази, положення, інструкції", href: "/students/parttime/#dokumenty" },
    ],
  },
  {
    title: "Підготовка кадрів (PhD)",
    icon: "🎓",
    links: [
      { label: "Розклад занять", href: "/students/phd/#rozklad-zanyat" },
      { label: "Атестація здобувачів", href: "/students/phd/#atestatsiya" },
      { label: "Академічна доброчесність", href: "/students/phd/#dobrochesnist" },
      { label: "Процедури захисту", href: "/students/phd/#zakhyst" },
      { label: "Корисно для науковців", href: "/students/phd/#korysno" },
    ],
  },
  {
    title: "Дистанційна форма навчання",
    icon: "💻",
    links: [
      { label: "Інформація та розклад", href: "/students/distance/" },
      { label: "Дозвілля", href: "/students/leisure/" },
    ],
  },
];

const services = [
  { label: "Освітні програми", href: "/students/#osvitni-prohramy" },
  { label: "Кабінет студента Digital University", href: "/students/#digital-university" },
  { label: "Замовлення довідок, дублікатів", href: "/students/#dovidky" },
  { label: "Підсумкова атестація", href: "/students/#pidsumkova-atestatsiya" },
  { label: "Індивідуальна освітня траєкторія", href: "/students/#trayektoriya" },
  { label: "Коди Google Classroom", href: "/students/#classroom" },
  { label: "Рейтинг успішності", href: "/students/#reityng" },
  { label: "Шаблони заяв", href: "/students/#shablony-zayav" },
];
---

<Base title="Здобувачам · ФКНТ" description="Інформація для студентів: розклади, графіки, контакти та важлива інформація для здобувачів ФКНТ.">
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <span>Здобувачам</span>
    </nav>

    <h1 class="display">Здобувачам</h1>
    <p class="lead">
      Все, що потрібно знати студентам, аспірантам та докторантам: розклади занять, графіки семестрів, 
      важлива інформація та послуги.
    </p>
  </section>

  <!-- ФОРМИ НАВЧАННЯ -->
  <section class="wrap cards-section">
    <h2 class="display">Форми навчання</h2>
    <div class="cards-grid">
      {sections.map((section) => (
        <div class="card">
          <div class="card-head">
            <span class="icon">{section.icon}</span>
            <h3>{section.title}</h3>
          </div>
          <ul class="card-links">
            {section.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ПОСЛУГИ -->
  <section class="wrap services-section">
    <div class="services-head">
      <div>
        <p class="eyebrow">Важливе</p>
        <h2 class="display">Послуги та інформація</h2>
      </div>
    </div>
    <div class="services-grid">
      {services.map((service) => (
        <a href={service.href} class="service-link">
          {service.label}
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap">
    <div class="cta-band">
      <h2 class="display">Потрібна допомога?</h2>
      <a class="btn dark" href="/contacts/">Контакти деканату →</a>
    </div>
  </section>
</Base>

<style>
  .page {
    padding: 40px 24px 20px;
  }

  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  h1 {
    color: var(--deep);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: 16px;
  }

  .lead {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0 0 28px;
    max-width: 56ch;
  }

  .cards-section {
    padding: 40px 24px;
  }

  .cards-section > h2 {
    color: var(--deep);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin-bottom: 28px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .icon {
    font-size: 2rem;
  }

  .card-head h3 {
    color: var(--deep);
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.3;
  }

  .card-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-links li a {
    display: block;
    padding: 8px 0;
    font-size: 0.95rem;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .card-links li a:hover {
    color: var(--deep);
    border-bottom-color: var(--primary);
  }

  .services-section {
    padding: 40px 24px;
    background: var(--tint);
  }

  .services-head {
    margin-bottom: 28px;
  }

  .services-head h2 {
    color: var(--deep);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin-top: 8px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: #fff;
    border-radius: 8px;
    font-weight: 600;
    color: var(--deep);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    border: 1px solid var(--line);
  }

  .service-link:hover {
    background: #fff;
    color: var(--primary);
    border-color: var(--primary);
  }

  .arrow {
    margin-left: 8px;
    font-size: 0.9rem;
  }

  .cta-band {
    background: var(--signal);
    color: #0e1533;
    border-radius: 20px;
    padding: 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin: 40px 0 60px;
    flex-wrap: wrap;
  }

  .cta-band .display {
    margin: 0;
    flex: 1;
    min-width: 240px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    padding: 13px 24px;
    border-radius: 8px;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn.dark {
    background: var(--primary);
    color: #fff;
  }

  .eyebrow {
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal-2);
  }

  @media (max-width: 600px) {
    .page {
      padding: 32px 16px 16px;
    }

    h1 {
      font-size: 1.8rem;
      margin-bottom: 12px;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .cta-band {
      flex-direction: column;
      text-align: center;
    }

    .cta-band .display {
      min-width: unset;
      width: 100%;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
