---
import Base from "../layouts/Base.astro";
import DepartmentCard from "../components/DepartmentCard.astro";
import departments from "../data/departments.json";
import team from "../data/team.json";
import { getCollection } from "astro:content";

const featuredTeam = team.filter((m) => m.featured);

const news = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base title="ФКНТ — Факультет комп'ютерних наук та технологій">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow">Факультет комп'ютерних наук та технологій · КАІ</p>
      <h1 class="display">Вивчай ІТ,<br><span>досліджуючи!</span></h1>
      <p class="lead">Злітна смуга у твоє цифрове майбутнє. Готуємо ІТ-фахівців з аналізу даних, штучного інтелекту, кібербезпеки та розробки ПЗ.</p>
      <div class="cta">
        <a class="btn" href="/admission/">Вступ 2026 →</a>
        <a class="btn ghost" href="/faculty/departments/">Обрати кафедру</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats">
    <div><b class="display">1965</b><span>Рік заснування</span></div>
    <div><b class="display">9</b><span>Кафедр</span></div>
    <div><b class="display">7</b><span>Спеціальностей</span></div>
    <div><b class="display">60+</b><span>Років досвіду</span></div>
  </section>

  <!-- NEWS -->
  {news.length > 0 && (
    <section class="wrap news">
      <div class="news-head">
        <div>
          <p class="eyebrow">Стрічка</p>
          <h2 class="display">Новини факультету</h2>
        </div>
        <a class="lnk" href="/news/">Усі новини →</a>
      </div>
      <div class="news-grid">
        {news.map((p) => (
          <a class="card" href={`/news/${p.slug}/`}>
            {p.data.cover && <img class="thumb" src={p.data.cover} alt="" loading="lazy" />}
            <div class="card-body">
              <time datetime={p.data.date.toISOString()}>
                {p.data.date.toLocaleDateString("uk-UA", { day: "numeric", month: "long", year: "numeric" })}
              </time>
              <span class="cat">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- DEPARTMENTS -->
  <section class="wrap depts">
    <div class="depts-head">
      <div>
        <p class="eyebrow">Підрозділи</p>
        <h2 class="display">Кафедри та лабораторії</h2>
      </div>
      <div class="depts-controls">
        <button class="arrow" id="dept-prev" aria-label="Попередні">←</button>
        <button class="arrow" id="dept-next" aria-label="Наступні">→</button>
        <a class="lnk" href="/faculty/departments/">Усі підрозділи →</a>
      </div>
    </div>
    <div class="dept-carousel" id="dept-carousel">
      {departments.map((d) => (
        <div class="dept-slide"><DepartmentCard {...d} /></div>
      ))}
    </div>
  </section>

  <!-- TEAM -->
  <section class="wrap team">
    <div class="team-head">
      <div>
        <p class="eyebrow">Люди</p>
        <h2 class="display">Команда факультету</h2>
      </div>
      <a class="lnk" href="/faculty/team/">Уся команда →</a>
    </div>
    <div class="team-grid">
      {featuredTeam.map((m) => (
        <div class="team-card">
          <img src={m.photo} alt={m.name} loading="lazy" />
          <div class="info">
            <h3>{m.name}</h3>
            <p class="role">{m.role}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap">
    <div class="cta-band">
      <h2 class="display">Готовий вступити на ФКНТ?</h2>
      <a class="btn dark" href="/admission/">Умови вступу →</a>
    </div>
  </section>
</Base>

<style>
  .hero{background:var(--grad-dark, linear-gradient(135deg,#023FC1,#1E2A7C));color:#fff;padding:80px 0}
  .hero-inner{max-width:640px}
  .eyebrow{font-weight:800;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--signal-2,#FECC59)}
  .hero h1{font-size:clamp(2.4rem,6vw,4rem);margin:18px 0}
  .hero h1 span{color:var(--signal,#FEAB24)}
  .lead{font-size:1.1rem;color:#d3ddff;margin-bottom:28px}
  .cta{display:flex;gap:14px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:8px;font-weight:800;padding:13px 24px;border-radius:8px;background:var(--signal,#FEAB24);color:#0E1533}
  .btn.ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5)}
  .btn.dark{background:var(--primary,#023FC1);color:#fff}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;padding:44px 24px;text-align:center}
  .stats b{display:block;font-size:2.2rem;color:var(--primary,#023FC1)}
  .stats span{font-size:.85rem;color:var(--muted,#5B6485)}
  .news{padding:20px 24px 40px}
  .news-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px}
  .news-head h2{color:var(--deep,#1E2A7C);font-size:clamp(1.6rem,3.4vw,2.2rem);margin-top:8px}
  .news-head .lnk{font-weight:800;color:var(--primary,#023FC1);white-space:nowrap}
  .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .news-grid .card{display:block;border:1px solid var(--line,#E3E9F5);border-left:4px solid var(--sky,#2D8CDF);
    border-radius:12px;overflow:hidden;background:#fff;transition:transform .2s,border-color .2s}
  .news-grid .card:hover{transform:translateY(-3px);border-left-color:var(--signal,#FEAB24)}
  .news-grid .thumb{width:100%;height:150px;object-fit:cover;display:block}
  .news-grid .card-body{padding:22px}
  .news-grid time{font-size:.78rem;color:var(--muted,#5B6485);font-weight:700}
  .news-grid .cat{font-size:.64rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--sky,#2D8CDF);margin-left:8px}
  .news-grid h3{color:var(--deep,#1E2A7C);font-size:1.05rem;margin:10px 0 6px}
  .news-grid p{color:var(--muted,#5B6485);font-size:.9rem;margin:0}
  .depts{padding:40px 24px 20px}
  .depts-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}
  .depts-head h2{color:var(--deep,#1E2A7C);font-size:clamp(1.8rem,4vw,2.6rem);margin-top:8px}
  .depts-controls{display:flex;align-items:center;gap:10px}
  .depts-controls .lnk{font-weight:800;color:var(--primary,#023FC1);white-space:nowrap;margin-left:6px}
  .arrow{width:40px;height:40px;border-radius:50%;border:1px solid var(--line,#E3E9F5);background:#fff;
    color:var(--deep,#1E2A7C);font-size:1.1rem;cursor:pointer;transition:.2s}
  .arrow:hover{background:var(--tint,#F4F7FD);border-color:var(--primary,#023FC1)}
  .dept-carousel{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 12px;
    scrollbar-width:none}
  .dept-carousel::-webkit-scrollbar{display:none}
  .dept-slide{flex:none;width:300px;scroll-snap-align:start}
  .dept-slide :global(.card){height:100%}
  .team{padding:20px 24px 20px}
  .team-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}
  .team-head h2{color:var(--deep,#1E2A7C);font-size:clamp(1.8rem,4vw,2.6rem);margin-top:8px}
  .team-head .lnk{font-weight:800;color:var(--primary,#023FC1);white-space:nowrap}
  .team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
  .team-card{border:1px solid var(--line,#E3E9F5);border-radius:12px;overflow:hidden;background:#fff;
    transition:transform .2s,box-shadow .2s}
  .team-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .team-card img{width:100%;height:220px;object-fit:cover;display:block;background:var(--tint,#F4F7FD)}
  .team-card .info{padding:16px}
  .team-card h3{color:var(--deep,#1E2A7C);font-size:1rem;margin:0 0 4px}
  .team-card .role{color:var(--sky,#2D8CDF);font-weight:800;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em;margin:0}
  .cta-band{background:var(--signal,#FEAB24);color:#0E1533;border-radius:20px;padding:36px;display:flex;justify-content:space-between;align-items:center;gap:20px;margin:40px 0 60px;flex-wrap:wrap}
  @media(max-width:900px){.stats{grid-template-columns:1fr 1fr}.news-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:600px){.news-grid{grid-template-columns:1fr}.news-head{flex-direction:column;align-items:flex-start}
    .depts-head{flex-direction:column;align-items:flex-start}.dept-slide{width:82vw}}
</style>

<script>
  const track = document.getElementById('dept-carousel');
  if (track) {
    const step = () => (track.querySelector('.dept-slide')?.offsetWidth || 300) + 18;
    const atEnd = () => track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;

    const goPrev = () => track.scrollBy({ left: -step(), behavior: 'smooth' });
    const goNext = () => {
      if (atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
      else track.scrollBy({ left: step(), behavior: 'smooth' });
    };

    let timer;
    const startAutoplay = () => { timer = setInterval(goNext, 5000); };
    const stopAutoplay = () => clearInterval(timer);
    const restartAutoplay = () => { stopAutoplay(); startAutoplay(); };

    document.getElementById('dept-prev')?.addEventListener('click', () => { goPrev(); restartAutoplay(); });
    document.getElementById('dept-next')?.addEventListener('click', () => { goNext(); restartAutoplay(); });

    track.addEventListener('mouseenter', stopAutoplay);
    track.addEventListener('mouseleave', startAutoplay);
    track.addEventListener('touchstart', stopAutoplay, { passive: true });
    track.addEventListener('touchend', startAutoplay);

    startAutoplay();
  }
</script>
