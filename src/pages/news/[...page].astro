---
// /news/ (сторінка 1) і /news/2/, /news/3/… — стрічка новин, розбита на сторінки
// вбудованою пагінацією Astro. Додав markdown-файл → зʼявилась картка на
// потрібній сторінці. Без ручної верстки.
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("news", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
const title = page.currentPage === 1 ? "Новини · ФКНТ" : `Новини · сторінка ${page.currentPage} · ФКНТ`;
---
<Base title={title}>
  <section class="wrap page">
    <h1 class="display">Новини</h1>
    <div class="feed">
      {page.data.map((p) => (
        <a class="item" href={`/news/${p.id}/`}>
          {p.data.cover && <img class="thumb" src={p.data.cover} alt="" loading="lazy" />}
          <div class="body">
            <time datetime={p.data.date.toISOString()}>
              {p.data.date.toLocaleDateString("uk-UA", { day: "numeric", month: "long", year: "numeric" })}
            </time>
            <span class="cat">{p.data.category}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.summary}</p>
          </div>
        </a>
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="Пагінація новин">
        {page.url.prev
          ? <a class="pbtn" href={page.url.prev}>← Новіші</a>
          : <span class="pbtn disabled">← Новіші</span>}

        <div class="pnums">
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
            n === page.currentPage
              ? <span class="pnum current" aria-current="page">{n}</span>
              : <a class="pnum" href={n === 1 ? "/news/" : `/news/${n}/`}>{n}</a>
          ))}
        </div>

        {page.url.next
          ? <a class="pbtn" href={page.url.next}>Старіші →</a>
          : <span class="pbtn disabled">Старіші →</span>}
      </nav>
    )}
  </section>
</Base>

<style>
  .page{padding:40px 24px 20px}
  h1{color:var(--deep);font-size:clamp(2rem,4vw,2.8rem);margin-bottom:28px}
  .feed{display:grid;gap:16px}
  .item{display:flex;gap:20px;align-items:stretch;border:1px solid var(--line);border-left:4px solid var(--sky);border-radius:12px;
    padding:22px 24px;background:#fff;transition:transform .2s,border-color .2s}
  .item:hover{transform:translateY(-3px);border-left-color:var(--signal)}
  .thumb{flex:none;width:140px;height:100px;object-fit:cover;border-radius:8px}
  .item .body{min-width:0}
  time{font-size:.8rem;color:var(--muted);font-weight:700}
  .cat{font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
    color:var(--sky);margin-left:10px}
  .item h2{color:var(--deep);font-size:1.15rem;margin:8px 0 6px}
  .item p{color:var(--muted);font-size:.92rem;margin:0}
  @media(max-width:560px){.item{flex-direction:column}.thumb{width:100%;height:160px}}

  .pager{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:36px;flex-wrap:wrap}
  .pbtn{font-weight:800;font-size:.88rem;color:var(--primary);padding:9px 6px}
  .pbtn.disabled{color:var(--muted);opacity:.5;pointer-events:none}
  .pnums{display:flex;gap:6px;flex-wrap:wrap}
  .pnum{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;
    border-radius:var(--radius-sm);font-weight:700;font-size:.88rem;color:var(--deep);background:var(--tint)}
  .pnum:hover{background:var(--line)}
  .pnum.current{background:var(--signal);color:var(--ink)}
  @media(max-width:560px){.pager{justify-content:center}}
</style>
