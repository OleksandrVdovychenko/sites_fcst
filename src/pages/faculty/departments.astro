---
// /faculty/departments/ — уся сторінка = layout + дані + компонент.
// Порівняйте з рукописним HTML: тут немає повторюваної розмітки карток.
import Base from "../../layouts/Base.astro";
import DepartmentCard from "../../components/DepartmentCard.astro";
import departments from "../../data/departments.json";
---
<Base title="Кафедри та лабораторії · ФКНТ">
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <a href="/faculty/">Факультет</a> › <span>Кафедри</span>
    </nav>
    <h1 class="display">Кафедри та лабораторії</h1>
    <p class="lead">Дев'ять профільних кафедр, навчальний центр і науково-дослідна лабораторія.</p>

    <div class="filters" role="tablist" aria-label="Тип підрозділу">
      <button type="button" role="tab" aria-selected="true" data-filter="all">Усі підрозділи</button>
      <button type="button" role="tab" aria-selected="false" data-filter="dept">Кафедри</button>
      <button type="button" role="tab" aria-selected="false" data-filter="lab">Лабораторії</button>
      <button type="button" role="tab" aria-selected="false" data-filter="center">Навчальні центри</button>
    </div>

    <div class="grid">
      {departments.map((d) => <DepartmentCard {...d} />)}
    </div>
  </section>
</Base>

<style>
  .page{padding:40px 24px 20px}
  .crumbs{font-size:.85rem;color:var(--muted);margin-bottom:16px}
  .crumbs a:hover{color:var(--primary)}
  h1{color:var(--deep);font-size:clamp(2rem,4vw,2.8rem)}
  .lead{color:var(--muted);font-size:1.05rem;margin:14px 0 28px;max-width:52ch}

  .filters{display:inline-flex;gap:6px;background:var(--tint);padding:6px;border-radius:12px;margin-bottom:28px;flex-wrap:wrap}
  .filters button{font:inherit;font-weight:800;font-size:.88rem;padding:9px 18px;border:0;background:none;
    border-radius:8px;cursor:pointer;color:var(--muted)}
  .filters button[aria-selected="true"]{background:#fff;color:var(--primary);box-shadow:var(--shadow-sm,0 4px 14px -6px rgba(14,21,51,.25))}

  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .grid :global(.card.is-hidden){display:none}
  @media(max-width:900px){.grid{grid-template-columns:1fr 1fr}}
  @media(max-width:600px){.grid{grid-template-columns:1fr}}
</style>

<script>
  const buttons = document.querySelectorAll('.filters button');
  const cards = document.querySelectorAll('.grid [data-type]');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    buttons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
    const filter = btn.getAttribute('data-filter');
    cards.forEach((card) => {
      card.classList.toggle('is-hidden', filter !== 'all' && card.getAttribute('data-type') !== filter);
    });
  }));
</script>
