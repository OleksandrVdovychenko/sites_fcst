---
// /faculty/departments/ — уся сторінка = layout + дані + компонент.
// Структура факультету як розгортний список (DeptAccordion), а не
// фільтрована сітка карток — та губила ієрархію: лабораторія кафедри
// виглядала на сторінці так само, як самостійна.
import Base from "../../layouts/Base.astro";
import DeptAccordion from "../../components/DeptAccordion.astro";
import departments from "../../data/departments.json";

const deptCount = departments.filter((d) => d.type === "dept").length;
const labCenterCount =
  departments.filter((d) => d.type === "lab" || d.type === "center").length +
  departments.reduce((sum, d) => sum + (d.labs?.length ?? 0), 0);
---
<Base title="Структура факультету · ФКНТ">
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <a href="/faculty/">Факультет</a> › <span>Кафедри</span>
    </nav>
    <h1 class="display">Структура факультету</h1>
    <p class="lead">Дев'ять профільних кафедр, навчальні лабораторії й центри. Натисни на кафедру, щоб розгорнути.</p>

    <div class="structure">
      <span class="node">Деканат</span>
      <span class="arrow">→</span>
      <span class="node">{deptCount} кафедр</span>
      <span class="arrow">→</span>
      <span class="node">{labCenterCount} лабораторій і центрів</span>
    </div>

    <DeptAccordion departments={departments} />
  </section>
</Base>

<style>
  .page{padding:40px 24px 60px}
  .crumbs{font-size:.85rem;color:var(--muted);margin-bottom:16px}
  .crumbs a:hover{color:var(--primary)}
  h1{color:var(--deep);font-size:clamp(2rem,4vw,2.8rem)}
  .lead{color:var(--muted);font-size:1.05rem;margin:14px 0 28px;max-width:56ch}

  .structure{display:flex;align-items:center;flex-wrap:wrap;gap:10px;background:var(--tint);
    border-radius:var(--radius-sm);padding:16px 20px;margin-bottom:24px}
  .structure .node{font-weight:800;color:var(--deep);font-size:.94rem}
  .structure .arrow{color:var(--muted)}
</style>
