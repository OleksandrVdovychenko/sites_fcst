---
// /faculty/labs/cyber-threats/ — Науково-дослідна лабораторія протидії
// кіберзагрозам в авіагалузі, поза структурою кафедр. Фото поки немає.
import Base from "../../../layouts/Base.astro";

const equipment = ["Пентест", "Аудит кібербезпеки", "CERT/CSIRT", "Криптографія", "Постквантові рішення", "Реверс-інжиніринг"];
---
<Base
  title="Науково-дослідна лабораторія протидії кіберзагрозам в авіагалузі · ФКНТ"
  description="Наукові дослідження та розробка засобів кібербезпеки: захист авіаційних систем, пентест, аудит кібербезпеки, криптографія та постквантові рішення."
>
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <a href="/faculty/">Факультет</a> › <a href="/faculty/labs/">Лабораторії</a> ›
      <span>Протидії кіберзагрозам в авіагалузі</span>
    </nav>
    <p class="eyebrow">Науково-дослідна лабораторія</p>
    <h1 class="display">Науково-дослідна лабораторія протидії кіберзагрозам в авіагалузі</h1>
    <p class="lead">
      Лабораторія спеціалізується на фундаментальних і прикладних дослідженнях, розробленні
      науково-технічних рішень та наданні послуг у сфері кібербезпеки. Основними напрямами
      діяльності є захист авіаційних систем і критичної інформаційної інфраструктури, аудит та
      оцінювання кібербезпеки, тестування на проникнення, виявлення вразливостей, моделювання
      кіберзагроз, а також розроблення захищених програмних, криптографічних і постквантових
      рішень.
    </p>
  </section>

  <section class="wrap section split">
    <div>
      <h2 class="display">Чим займаються студенти</h2>
      <p>
        Лабораторія здійснює теоретичні дослідження та практичні розробки, зокрема створення
        прототипів програмних рішень і систем виявлення та реагування на кіберінциденти,
        математичне моделювання загроз та оцінювання ризиків. Окремими напрямами є підготовка
        фахівців CERT/CSIRT, пентестерів і аудиторів кібербезпеки, а також дослідження у сферах
        криптографії, мережевої безпеки, реверс-інжинірингу, штучного інтелекту та аналізу великих
        даних.
      </p>
    </div>
    <div class="equip-card">
      <h3>Напрями роботи</h3>
      <div class="tags">
        {equipment.map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <section class="wrap section cta-section">
    <h2 class="display">Хочете дізнатися більше?</h2>
    <p>Дізнайтеся більше про наукові дослідження та напрями співпраці лабораторії.</p>
    <a class="btn" href="https://cyberlab.nau.edu.ua" target="_blank" rel="noopener">Сайт лабораторії →</a>
  </section>
</Base>

<style>
.page { padding: 40px 24px 20px; }
.crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 16px; }
.crumbs a:hover { color: var(--primary); }
.eyebrow { font-weight: 800; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sky); }
h1 { color: var(--deep); font-size: clamp(1.6rem, 3.2vw, 2.3rem); margin: 12px 0 0; }
h2.display { color: var(--deep); font-size: clamp(1.4rem, 3vw, 1.8rem); }
.lead { color: var(--muted); font-size: 1.05rem; max-width: 70ch; margin: 14px 0 0; line-height: 1.65; }

.section { padding: 40px 24px; }

.split { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start; }
.split p { max-width: 70ch; margin-top: 14px; }
.equip-card { background: var(--tint); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
.equip-card h3 { color: var(--deep); font-size: .95rem; margin-bottom: 12px; }
.tags { display: flex; flex-wrap: wrap; gap: 7px; }
.tags span { font-size: .78rem; font-weight: 600; color: #39406a; background: #fff; border: 1px solid var(--line); padding: 5px 11px; border-radius: 20px; }

.cta-section { text-align: center; background: var(--tint); border-radius: var(--radius); margin: 8px 24px 40px; }
.cta-section p { color: var(--muted); max-width: 60ch; margin: 10px auto 20px; }

@media (max-width: 820px) {
  .split { grid-template-columns: 1fr; }
}
</style>
