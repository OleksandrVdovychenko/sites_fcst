---
// /faculty/labs/aviation-recorders/ — Навчальна лабораторія експлуатації
// автоматизованих систем контролю польотів (кафедра КІТ).
import Base from "../../../layouts/Base.astro";

const gallery = [
  { src: "/labs/aviation-recorders/flight-recorder-shelf.jpg", caption: "Бортові реєстратори польотної інформації на стелажах лабораторії" },
  { src: "/labs/aviation-recorders/ukrniira-recorder-unit.jpg", caption: "Реєстратор виробництва «УкрНДІРА» — моноблок ОРТ" },
  { src: "/labs/aviation-recorders/emergency-locator-recorders.jpg", caption: "Бортові аварійні самописці безводного типу" },
  { src: "/labs/aviation-recorders/msrp-control-panel.jpg", caption: "Система реєстрації параметрів польоту МСРП-42-96 з пультом керування" },
  { src: "/labs/aviation-recorders/recorder-internals.jpg", caption: "Розкриті реєстратори — внутрішня будова захисного блока" },
  { src: "/labs/aviation-recorders/flight-recorder-cvr.jpg", caption: "Бортовий мовний реєстратор (CVR) Fairchild" },
];

const equipment = ["Реєстратори польотної інформації", "АН-24", "АН-26", "АН-124 «Руслан»", "Мі-8", "МСРП-42-96"];
---
<Base
  title="Навчальна лабораторія експлуатації автоматизованих систем контролю польотів · Кафедра КІТ · ФКНТ"
  description="Лабораторія кафедри комп'ютерних інформаційних технологій з унікальною колекцією реєстраторів польотної інформації («чорних скриньок») та діючим макетом систем керування АН-124 «Руслан»."
>
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <a href="/faculty/">Факультет</a> › <a href="/faculty/labs/">Лабораторії</a> ›
      <span>Лабораторія контролю польотів</span>
    </nav>
    <p class="eyebrow">Кафедра комп'ютерних інформаційних технологій</p>
    <h1 class="display">Лабораторія «Експлуатації автоматизованих систем контролю польотів»</h1>
    <p class="lead">
      Лабораторія спеціалізується на отриманні, обробці та аналізі об'єктивної польотної
      інформації. Вона оснащена спеціалізованим обладнанням і комп'ютерною технікою, а також
      унікальною колекцією реєстраторів польотної інформації («чорних скриньок») українського
      та закордонного виробництва для різних типів повітряних суден, зокрема АН-24, АН-26,
      АН-124 «Руслан», Мі-8 та інших.
    </p>
  </section>

  <section class="wrap hero-photo">
    <div class="hero-frame">
      <img src="/labs/aviation-recorders/classroom-overview.jpg" alt="Навчальна аудиторія лабораторії з колекцією реєстраторів польотної інформації" />
      <div class="hero-caption">
        <p>Колекція реєстраторів польотної інформації на вітрині лабораторії</p>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <div>
      <h2 class="display">Чим займаються студенти</h2>
      <p>
        На базі лабораторії студенти набувають практичних навичок роботи з реєстраторами,
        вилучення та аналізу польотної інформації, проведення обчислювальних та імітаційних
        експериментів. Особливістю лабораторії є діючий макет систем керування літака АН-124
        «Руслан», що дає змогу відтворювати окремі етапи польоту та аналізувати відповідні
        дані. Також проводяться наукові дослідження, семінари та курси підвищення кваліфікації
        фахівців з обробки польотної інформації.
      </p>
    </div>
    <div class="equip-card">
      <h3>У колекції лабораторії</h3>
      <div class="tags">
        {equipment.map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="display">Лабораторія у фото</h2>
    <div class="gallery">
      {gallery.map((g) => (
        <figure>
          <img src={g.src} alt={g.caption} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap section cta-section">
    <h2 class="display">Хочете дізнатися більше?</h2>
    <p>Зв'яжіться з кафедрою комп'ютерних інформаційних технологій — розкажемо про навчальні курси на базі лабораторії.</p>
    <a class="btn" href="https://kit.nau.edu.ua" target="_blank" rel="noopener">Кафедра КІТ →</a>
  </section>
</Base>

<style>
.page { padding: 40px 24px 20px; }
.crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 16px; }
.crumbs a:hover { color: var(--primary); }
.eyebrow { font-weight: 800; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sky); }
h1 { color: var(--deep); font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 0; }
h2.display { color: var(--deep); font-size: clamp(1.4rem, 3vw, 1.8rem); }
.lead { color: var(--muted); font-size: 1.05rem; max-width: 70ch; margin: 14px 0 0; line-height: 1.65; }

.section { padding: 40px 24px; }

.hero-photo { margin-top: 12px; }
.hero-frame { position: relative; border-radius: var(--radius); overflow: hidden; }
.hero-frame img { width: 100%; height: 460px; object-fit: cover; }
.hero-caption {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: linear-gradient(0deg, rgba(14,21,51,.75), transparent 65%);
  padding: 28px 28px 20px;
}
.hero-caption p { margin: 0; color: #fff; font-size: .85rem; opacity: .9; }

.split { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start; }
.split p { max-width: 70ch; margin-top: 14px; }
.equip-card { background: var(--tint); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
.equip-card h3 { color: var(--deep); font-size: .95rem; margin-bottom: 12px; }
.tags { display: flex; flex-wrap: wrap; gap: 7px; }
.tags span { font-size: .78rem; font-weight: 600; color: #39406a; background: #fff; border: 1px solid var(--line); padding: 5px 11px; border-radius: 20px; }

.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; }
.gallery figure { margin: 0; border-radius: var(--radius-sm); overflow: hidden; background: var(--tint); }
.gallery img { width: 100%; height: 200px; object-fit: cover; }

.cta-section { text-align: center; background: var(--tint); border-radius: var(--radius); max-width: calc(var(--wrap) - 48px); margin: 8px auto 40px; }
.cta-section p { color: var(--muted); max-width: 60ch; margin: 10px auto 20px; }

@media (max-width: 820px) {
  .split { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: repeat(2, 1fr); }
  .hero-frame img { height: 280px; }
}
</style>
