---
// /faculty/labs/system-programming/ — Навчальна лабораторія системного
// програмування (кафедра ІКС).
import Base from "../../../layouts/Base.astro";
import Lightbox from "../../../components/Lightbox.astro";

const gallery = [
  { src: "/labs/system-programming/arduino-workstation.jpg", caption: "Робоче місце студента — ноутбук, Arduino Uno та макетна плата" },
  { src: "/labs/system-programming/arduino-ide-debugging.jpg", caption: "Налагодження прошивки в Arduino IDE" },
  { src: "/labs/system-programming/smart-house-model.jpg", caption: "Макет «розумного будинку» з датчиками, дисплеєм і сонячною панеллю" },
  { src: "/labs/system-programming/sensors-lecture.jpg", caption: "Лекція про принцип роботи датчиків з мікроконтролером" },
  { src: "/labs/system-programming/arduino-uno-closeup.jpg", caption: "Arduino Uno, підключена до макетної плати зі світлодіодом" },
];

const equipment = ["C/C++", "Python", "Rust", "Мікроконтролери", "Вбудовані системи", "GameDev"];
---
<Base
  title="Навчальна лабораторія системного програмування · Кафедра ІКС · ФКНТ"
  description="Лабораторія кафедри інтелектуальних кібернетичних систем для практичної підготовки з системного програмування, комп'ютерної інженерії та вбудованих систем."
>
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <a href="/faculty/">Факультет</a> › <a href="/faculty/labs/">Лабораторії</a> ›
      <span>Лабораторія системного програмування</span>
    </nav>
    <p class="eyebrow">Кафедра інтелектуальних кібернетичних систем</p>
    <h1 class="display">Навчальна лабораторія системного програмування</h1>
    <p class="lead">
      Лабораторія призначена для практичної підготовки здобувачів освіти у сферах системного
      програмування, комп'ютерної інженерії та інформаційних технологій. Основними напрямами роботи
      є програмування мовами C/C++, Python, Java та Rust, дослідження архітектури комп'ютерних та
      операційних систем, розроблення драйверів і вбудованих систем, робота з мікроконтролерами,
      паралельне програмування та системи реального часу.
    </p>
  </section>

  <section class="wrap hero-photo">
    <div class="hero-frame">
      <img src="/labs/system-programming/classroom-overview.jpg" alt="Аудиторія лабораторії системного програмування під час заняття з Arduino" />
      <div class="hero-caption">
        <p>Практичне заняття з розробки вбудованих систем на базі Arduino</p>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <div>
      <h2 class="display">Чим займаються студенти</h2>
      <p>
        Лабораторія є практичною базою спеціальності F7 «Комп'ютерна інженерія» та забезпечує
        виконання лабораторних, курсових і кваліфікаційних робіт, а також студентських наукових
        проєктів. Студенти програмують мікроконтролери, збирають та налагоджують макети на базі
        Arduino, вивчають роботу датчиків і виконавчих пристроїв. Окремим напрямом є розроблення
        ігрових рушіїв та програмних компонентів для GameDev, що дає змогу формувати практичні
        компетентності у сферах System Programming, Embedded Systems та розроблення
        високопродуктивного й апаратно-орієнтованого програмного забезпечення.
      </p>
    </div>
    <div class="equip-card">
      <h3>Технології та інструменти</h3>
      <div class="tags">
        {equipment.map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="display">Лабораторія у фото</h2>
    <div class="gallery">
      {gallery.map((g) => (
        <figure>
          <img src={g.src} alt={g.caption} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap section cta-section">
    <h2 class="display">Хочете дізнатися більше?</h2>
    <p>Зв'яжіться з кафедрою інтелектуальних кібернетичних систем — розкажемо про навчальні курси на базі лабораторії.</p>
    <a class="btn" href="http://ccs.nau.edu.ua" target="_blank" rel="noopener">Кафедра ІКС →</a>
  </section>

  <Lightbox />
</Base>

<style>
.page { padding: 40px 24px 20px; }
.crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 16px; }
.crumbs a:hover { color: var(--primary); }
.eyebrow { font-weight: 800; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sky); }
h1 { color: var(--deep); font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 0; }
h2.display { color: var(--deep); font-size: clamp(1.4rem, 3vw, 1.8rem); }
.lead { color: var(--muted); font-size: 1.05rem; max-width: 70ch; margin: 14px 0 0; line-height: 1.65; }

.section { padding: 40px 24px; }

.hero-photo { margin-top: 12px; }
.hero-frame { position: relative; border-radius: var(--radius); overflow: hidden; }
.hero-frame img { width: 100%; height: 460px; object-fit: cover; }
.hero-caption {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: linear-gradient(0deg, rgba(14,21,51,.75), transparent 65%);
  padding: 28px 28px 20px;
}
.hero-caption p { margin: 0; color: #fff; font-size: .85rem; opacity: .9; }

.split { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start; }
.split p { max-width: 70ch; margin-top: 14px; }
.equip-card { background: var(--tint); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
.equip-card h3 { color: var(--deep); font-size: .95rem; margin-bottom: 12px; }
.tags { display: flex; flex-wrap: wrap; gap: 7px; }
.tags span { font-size: .78rem; font-weight: 600; color: #39406a; background: #fff; border: 1px solid var(--line); padding: 5px 11px; border-radius: 20px; }

.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; }
.gallery figure { margin: 0; border-radius: var(--radius-sm); overflow: hidden; background: var(--tint); }
.gallery img { width: 100%; height: 200px; object-fit: cover; }

.cta-section { text-align: center; background: var(--tint); border-radius: var(--radius); max-width: calc(var(--wrap) - 48px); margin: 8px auto 40px; }
.cta-section p { color: var(--muted); max-width: 60ch; margin: 10px auto 20px; }

@media (max-width: 820px) {
  .split { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: repeat(2, 1fr); }
  .hero-frame img { height: 280px; }
}
</style>
