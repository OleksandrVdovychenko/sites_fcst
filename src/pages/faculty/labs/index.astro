---
// /faculty/labs/ — хаб усіх навчальних лабораторій факультету: фото-картки
// замість того, щоб ховати посилання всередині акордеона кафедр.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import departments from "../../../data/departments.json";
import { getCollection } from "astro:content";

// Мініатюра береться з фото самої сторінки лабораторії (src/content/labs/*.json),
// а не з окремо підтримуваного мапінгу — додав .json з hero-фото, картка сама її підхопить.
const labPages = await getCollection("labs");
const thumbs: Record<string, string> = Object.fromEntries(
  labPages.filter((l) => l.data.hero).map((l) => [`/faculty/labs/${l.id}/`, l.data.hero!.src])
);

type LabCard = { name: string; parent: string; url?: string; external?: boolean };

const isRealUrl = (u?: string) => !!u && u !== "#";
const isExternalUrl = (u?: string) => isRealUrl(u) && /^https?:\/\//.test(u!);

const cards: LabCard[] = [];
for (const d of departments as any[]) {
  if (d.type === "dept" && d.labs) {
    for (const lab of d.labs) {
      cards.push({ name: lab.name, parent: d.name, url: lab.url, external: isExternalUrl(lab.url) });
    }
  }
  if (d.type === "lab" || d.type === "center") {
    cards.push({ name: d.name, parent: d.kind, url: isRealUrl(d.url) ? d.url : undefined, external: isExternalUrl(d.url) });
  }
}
const hasThumb = (c: LabCard) => !!(c.url && !c.external && thumbs[c.url]);
cards.sort((a, b) => Number(hasThumb(b)) - Number(hasThumb(a)));
---
<Base
  title="Навчальні лабораторії · ФКНТ"
  description="Навчальні та науково-дослідні лабораторії факультету комп'ютерних наук та технологій — обладнання, фото, напрями роботи."
>
  <section class="wrap page">
    <Breadcrumbs items={[{ label: "Головна", href: "/" }, { label: "Факультет", href: "/faculty/" }, { label: "Лабораторії" }]} />
    <p class="eyebrow">Матеріальна база факультету</p>
    <h1 class="display">Навчальні лабораторії</h1>
    <p class="lead">
      Реальне обладнання, на якому студенти вчаться — від мережевих стійок Cisco до колекції
      авіаційних реєстраторів польотної інформації. Готові сторінки з фото — нижче; решта
      лабораторій поки без власної сторінки.
    </p>
  </section>

  <section class="wrap section">
    <div class="grid">
      {cards.map((c) => (
        hasThumb(c) ? (
          <a class="card ready" href={c.url}>
            <div class="thumb"><img src={thumbs[c.url!]} alt={c.name} loading="lazy" /></div>
            <div class="body">
              <p class="parent">{c.parent}</p>
              <h3>{c.name}</h3>
              <span class="cta">Переглянути →</span>
            </div>
          </a>
        ) : c.external ? (
          <a class="card ready no-thumb" href={c.url} target="_blank" rel="noopener">
            <div class="body">
              <p class="parent">{c.parent}</p>
              <h3>{c.name}</h3>
              <span class="cta">Сайт лабораторії →</span>
            </div>
          </a>
        ) : c.url ? (
          <a class="card ready no-thumb" href={c.url}>
            <div class="body">
              <p class="parent">{c.parent}</p>
              <h3>{c.name}</h3>
              <span class="cta">Переглянути →</span>
            </div>
          </a>
        ) : (
          <div class="card soon">
            <div class="body">
              <p class="parent">{c.parent}</p>
              <h3>{c.name}</h3>
              <span class="badge">незабаром</span>
            </div>
          </div>
        )
      ))}
    </div>
  </section>
</Base>

<style>
.page { padding: 40px 24px 20px; }
h1 { color: var(--deep); font-size: clamp(2rem, 4vw, 2.8rem); margin: 12px 0 0; }
.lead { margin-bottom: 0; }

.section { padding: 20px 24px 60px; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }

.card {
  display: flex; flex-direction: column;
  border: 1px solid var(--line); border-radius: var(--radius);
  background: #fff; overflow: hidden;
}
.card.ready { transition: transform .18s, box-shadow .18s; }
.card.ready:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -18px rgba(2,63,193,.3); }

.thumb { aspect-ratio: 16/10; overflow: hidden; background: var(--tint); }
.thumb img { width: 100%; height: 100%; object-fit: cover; }

.body { padding: 16px 18px 18px; flex: 1; display: flex; flex-direction: column; gap: 6px; }
.parent { font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--sky); margin: 0; }
.card h3 { color: var(--deep); font-size: 1rem; line-height: 1.3; margin: 0; }
.card.soon h3 { color: var(--muted); }
.cta { margin-top: auto; padding-top: 8px; font-weight: 800; font-size: .86rem; color: var(--primary); }
.badge {
  align-self: flex-start; margin-top: auto;
  font-size: .64rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
  color: var(--sky); background: var(--tint); border-radius: 20px; padding: 3px 9px;
}
.card.soon { background: var(--tint); }
</style>
