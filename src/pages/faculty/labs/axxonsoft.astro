---
// /faculty/labs/axxonsoft/ — Лабораторія штучного інтелекту у сфері безпеки AxxonSoft
// (створена у партнерстві AxxonSoft та КАІ, поза структурою кафедр).
import Base from "../../../layouts/Base.astro";

const gallery = [
  { src: "/labs/axxonsoft/noder-axxonsoft-wall.jpg", caption: "Стенд партнерів NODER і AxxonSoft з камерою відеоспостереження Hikvision" },
  { src: "/labs/axxonsoft/psim-modules-showcase.jpg", caption: "Модулі платформи Axxon PSIM — FACE, AUTO, POS, RETAIL, ACFA, RAILWAY" },
  { src: "/labs/axxonsoft/basip-intercom-stand.jpg", caption: "Стенд IP-домофонії BAS-IP та схема інтеграції Axxon Intellect" },
  { src: "/labs/axxonsoft/iso-certification-board.jpg", caption: "Сертифікат лабораторії — стандарти ISO 9001:2015 та ISO 27001:2022" },
  { src: "/labs/axxonsoft/classroom-angle.jpg", caption: "Аудиторія лабораторії — робочі місця студентів" },
  { src: "/labs/axxonsoft/psim-brochure.jpg", caption: "Інформаційний буклет платформи Axxon PSIM" },
];

const equipment = ["Штучний інтелект", "Відеоаналітика", "Розпізнавання облич і номерів", "Axxon PSIM", "Smart City", "IP-домофонія BAS-IP"];
---
<Base
  title="Лабораторія штучного інтелекту у сфері безпеки AxxonSoft · ФКНТ"
  description="Лабораторія штучного інтелекту у сфері безпеки, створена у партнерстві AxxonSoft та Київського авіаційного інституту — нейромережева відеоаналітика, розпізнавання облич, Smart City."
>
  <section class="wrap page">
    <nav class="crumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a> › <a href="/faculty/">Факультет</a> › <a href="/faculty/labs/">Лабораторії</a> ›
      <span>«AxxonSoft»</span>
    </nav>
    <p class="eyebrow">Навчальна лабораторія інтелектуальних систем безпеки</p>
    <h1 class="display">Лабораторія штучного інтелекту у сфері безпеки AxxonSoft</h1>
    <p class="lead">
      Лабораторія, створена у партнерстві AxxonSoft та Київського авіаційного інституту, поєднує
      академічну науку, сучасні комерційні технології та практичні рішення у сфері інтелектуальних
      систем безпеки. Основними напрямами діяльності є дослідження та впровадження штучного
      інтелекту, нейромережевої відеоаналітики, розпізнавання облич і номерних знаків, систем
      управління безпекою та інтегрованих рішень Smart City.
    </p>
  </section>

  <section class="wrap hero-photo">
    <div class="hero-frame">
      <img src="/labs/axxonsoft/classroom-overview.jpg" alt="Навчальна аудиторія лабораторії AxxonSoft" />
      <div class="hero-caption">
        <p>Аудиторія лабораторії — партнерство AxxonSoft та Київського авіаційного інституту</p>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <div>
      <h2 class="display">Чим займаються студенти</h2>
      <p>
        На базі лабораторії проводяться прикладні AI-дослідження, тестування та прототипування
        систем безпеки, моделювання сценаріїв інцидентів і розроблення концепцій комплексних систем
        безпеки. Особливістю лабораторії є використання реальних комерційних технологій, що
        застосовуються на об'єктах критичної інфраструктури, транспорту, промисловості, у містах
        та бізнесі. Представлені рішення орієнтовані на міжнародні вимоги до якості та інформаційної
        безпеки, зокрема стандарти ISO та вимоги GDPR.
      </p>
    </div>
    <div class="equip-card">
      <h3>Технології та рішення</h3>
      <div class="tags">
        {equipment.map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="display">Лабораторія у фото</h2>
    <div class="gallery">
      {gallery.map((g) => (
        <figure>
          <img src={g.src} alt={g.caption} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap section cta-section">
    <h2 class="display">Хочете дізнатися більше?</h2>
    <p>Лабораторія створена у партнерстві з компанією AxxonSoft — розробником платформи Axxon PSIM.</p>
    <a class="btn" href="https://axxonsoft.com" target="_blank" rel="noopener">AxxonSoft →</a>
  </section>
</Base>

<style>
.page { padding: 40px 24px 20px; }
.crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 16px; }
.crumbs a:hover { color: var(--primary); }
.eyebrow { font-weight: 800; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sky); }
h1 { color: var(--deep); font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 0; }
h2.display { color: var(--deep); font-size: clamp(1.4rem, 3vw, 1.8rem); }
.lead { color: var(--muted); font-size: 1.05rem; max-width: 70ch; margin: 14px 0 0; line-height: 1.65; }

.section { padding: 40px 24px; }

.hero-photo { margin-top: 12px; }
.hero-frame { position: relative; border-radius: var(--radius); overflow: hidden; }
.hero-frame img { width: 100%; height: 460px; object-fit: cover; }
.hero-caption {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: linear-gradient(0deg, rgba(14,21,51,.75), transparent 65%);
  padding: 28px 28px 20px;
}
.hero-caption p { margin: 0; color: #fff; font-size: .85rem; opacity: .9; }

.split { display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start; }
.split p { max-width: 70ch; margin-top: 14px; }
.equip-card { background: var(--tint); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
.equip-card h3 { color: var(--deep); font-size: .95rem; margin-bottom: 12px; }
.tags { display: flex; flex-wrap: wrap; gap: 7px; }
.tags span { font-size: .78rem; font-weight: 600; color: #39406a; background: #fff; border: 1px solid var(--line); padding: 5px 11px; border-radius: 20px; }

.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; }
.gallery figure { margin: 0; border-radius: var(--radius-sm); overflow: hidden; background: var(--tint); }
.gallery img { width: 100%; height: 200px; object-fit: cover; }

.cta-section { text-align: center; background: var(--tint); border-radius: var(--radius); margin: 8px 24px 40px; }
.cta-section p { color: var(--muted); max-width: 60ch; margin: 10px auto 20px; }

@media (max-width: 820px) {
  .split { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: repeat(2, 1fr); }
  .hero-frame img { height: 280px; }
}
</style>
