---
// /faculty/team/ — команда факультету. Джерело: fcst.kai.edu.ua/stage/наша-команда/.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import team from "../../data/team.json";
---
<Base title="Команда факультету · ФКНТ" description="Керівництво Факультету комп'ютерних наук та технологій.">
  <section class="wrap page">
    <Breadcrumbs items={[{ label: "Головна", href: "/" }, { label: "Факультет", href: "/faculty/" }, { label: "Команда факультету" }]} />
    <h1 class="display">Команда факультету</h1>
    <p class="lead">Керівництво Факультету комп'ютерних наук та технологій.</p>

    <div class="grid">
      {team.map((m) => (
        <article class="card">
          <img src={m.photo} alt={m.name} loading="lazy" />
          <div class="info">
            <h2>{m.name}</h2>
            <p class="role">{m.role}</p>
            <p class="desc">{m.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .page{padding:40px 24px 60px}
  h1{color:var(--deep);font-size:clamp(2rem,4vw,2.8rem)}
  .lead{margin-bottom:36px;max-width:60ch}

  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .card{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff;
    transition:transform .2s,box-shadow .2s}
  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .card img{width:100%;height:260px;object-fit:cover;display:block;background:var(--tint)}
  .info{padding:20px}
  .info h2{color:var(--deep);font-size:1.1rem;margin:0 0 4px}
  .role{color:var(--sky);font-weight:800;font-size:.82rem;text-transform:uppercase;letter-spacing:.04em;margin:0 0 10px}
  .desc{color:var(--muted);font-size:.9rem;margin:0}

  @media(max-width:860px){.grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.grid{grid-template-columns:1fr}}
</style>
