---
// /faculty/partners/ — партнери факультету. Дані (лого, опис, сайт) — src/data/partners.json,
// лого — public/partners/.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import partners from "../../data/partners.json";
---
<Base title="Наші партнери · ФКНТ" description="ІТ-компанії та організації, з якими співпрацює факультет.">
  <section class="wrap page">
    <Breadcrumbs items={[{ label: "Головна", href: "/" }, { label: "Факультет", href: "/faculty/" }, { label: "Наші партнери" }]} />
    <p class="eyebrow">Спільно з індустрією</p>
    <h1 class="display">Наші партнери</h1>
    <p class="lead">Факультет співпрацює з ІТ-компаніями та організаціями з питань освіти, кібербезпеки та практичної підготовки студентів.</p>

    <div class="pgrid">
      {partners.map((p) => (
        <article class="pcard">
          <a class="plogo" href={p.url} target="_blank" rel="noopener" aria-label={`${p.name} — офіційний сайт`}>
            <img src={p.logo} alt={p.name} loading="lazy" />
          </a>
          <h2>{p.name}</h2>
          <p>{p.desc}</p>
          <a class="plink" href={p.url} target="_blank" rel="noopener">Офіційний сайт →</a>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .page{padding:40px 24px 60px}
  h1{color:var(--deep);font-size:clamp(2rem,4vw,2.8rem);margin:12px 0 14px}
  .lead{margin:0 0 40px;max-width:60ch}

  .pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
  .pcard{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:var(--radius);background:#fff;padding:22px;
    transition:transform .2s,box-shadow .2s}
  .pcard:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
  .plogo{display:flex;align-items:center;justify-content:center;height:96px;margin-bottom:18px;
    background:#fff;border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px 22px}
  .plogo img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}
  .pcard h2{color:var(--deep);font-size:1.05rem;margin:0 0 8px}
  .pcard p{color:var(--muted);font-size:.9rem;line-height:1.55;margin:0 0 16px}
  .plink{margin-top:auto;font-weight:800;font-size:.86rem;color:var(--primary)}
  .plink:hover{color:var(--deep)}
</style>
