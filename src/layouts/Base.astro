---
// Base.astro — СПІЛЬНА ОБОЛОНКА. Меню правиться тут — застосовується на всіх сторінках.
import "../styles/tokens.css";
import nav from "../data/nav.json";

const { title = "ФКНТ — Факультет комп'ютерних наук та технологій", description = "Вивчай ІТ, досліджуючи!" } = Astro.props;

// nav: src/data/nav.json — { label, href, mega?: { cols: "pg-2"|"pg-3"|"pg-4",
// groups: [{ title, links:[{label,href}] }], feature?: {display,text,href,cta} } }
const path = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && path.startsWith(href);
const isExternal = (href: string) => href.startsWith("http");
const extAttrs = (href: string) => isExternal(href) ? { target: "_blank", rel: "noopener" } : {};

// Сторінки, які вже реально існують у src/pages, — виводяться з файлової системи,
// а не підтримуються вручну (раніше список дублював структуру src/pages і розсинхронювався:
// /students/ була збудована, але відсутня у списку — через це 8 пунктів підменю
// «Здобувачу → Освітній процес» показувались як «незабаром» замість активних посилань).
// Виняток — маршрути на основі рест-параметрів (пагінація/[...slug]): у них нема власного
// файла для конкретно "кореневої" адреси, тож для них потрібен один ручний запис.
const pageFiles = Object.keys(import.meta.glob("../pages/**/*.astro"));
const dynamicRouteRoots = ["/news/"];
const builtPages = new Set([
  ...pageFiles
    .filter((f) => !f.includes("["))
    .map((f) => {
      const route = f.replace("../pages", "").replace(/\.astro$/, "").replace(/\/index$/, "/") || "/";
      return route.endsWith("/") ? route : `${route}/`;
    }),
  ...dynamicRouteRoots,
]);
const isReady = (href: string) => isExternal(href) || builtPages.has(href.split("#")[0]);
---
<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Mulish:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="logo" href="/">
        <img src="/fcst_logo_header.png" alt="ФКНТ — Факультет комп'ютерних наук та технологій" height="52" />
      </a>

      <nav class="nav" aria-label="Головне меню">
        {nav.map((i) => i.mega ? (
          <div class="nav-item">
            <a href={i.href} aria-current={isActive(i.href) ? "page" : undefined}>{i.label}<span class="caret"></span></a>
            <div class="dd">
              <div class={`panel panel-grid ${i.mega.cols}`}>
                {i.mega.groups.map((g) => (
                  <div class="col">
                    <h5>{g.title}</h5>
                    <ul>
                      {g.links.map((c) => (
                        <li>{isReady(c.href) ? (
                          <a href={c.href} {...extAttrs(c.href)}>{c.label}</a>
                        ) : (
                          <span class="soon">{c.label}</span>
                        )}</li>
                      ))}
                    </ul>
                  </div>
                ))}
                {i.mega.feature && (
                  <div class="col" style="grid-column:span 2">
                    <div class="panel-feature">
                      <div>
                        <div class="display">{i.mega.feature.display}</div>
                        <p>{i.mega.feature.text}</p>
                      </div>
                      <a href={i.mega.feature.href}>{i.mega.feature.cta} <span class="arw">→</span></a>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ) : (
          <a class="nav-link" href={i.href} aria-current={isActive(i.href) ? "page" : undefined}>{i.label}</a>
        ))}
      </nav>

      <a class="btn cta-desktop" href="https://pk.kai.edu.ua/faculties/fakultet-kompyuternyh-nauk-ta-tehnologij/" target="_blank" rel="noopener">Вступ 2026 →</a>

      <label for="nt" class="burger" aria-label="Меню"><span></span></label>
    </div>
  </header>

  <input type="checkbox" id="nt" class="nav-toggle" />
  <div class="drawer">
    <label for="nt" class="scrim" aria-label="Закрити"></label>
    <div class="sheet">
      {nav.map((i) => i.mega ? (
        <details>
          <summary>{i.label}</summary>
          <div class="sub">
            {i.mega.groups.map((g) => (
              <>
                <p class="grp">{g.title}</p>
                {g.links.map((c) => isReady(c.href) ? (
                  <a href={c.href} {...extAttrs(c.href)}>{c.label}</a>
                ) : (
                  <span class="soon">{c.label}</span>
                ))}
              </>
            ))}
          </div>
        </details>
      ) : (
        <a class="m-link" href={i.href}>{i.label}</a>
      ))}
      <a class="btn" href="https://pk.kai.edu.ua/faculties/fakultet-kompyuternyh-nauk-ta-tehnologij/" target="_blank" rel="noopener">Вступ 2026 →</a>
    </div>
  </div>

  <main><slot /></main>

  <footer class="foot">
    <div class="wrap">
      <p class="display">Вивчай ІТ, досліджуючи!</p>
      <p>© {new Date().getFullYear()} Факультет комп'ютерних наук та технологій · Est. 1965</p>
    </div>
  </footer>

  <style>
    .site{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
    .bar{display:flex;align-items:center;justify-content:space-between;height:80px;gap:16px}
    .logo{flex:none}
    .logo img{display:block;height:52px;width:auto;flex-shrink:0}

    /* desktop nav */
    .nav{display:flex;gap:2px;align-items:center}
    .nav-item{position:relative}
    .nav-item>a,.nav-link{display:inline-flex;align-items:center;gap:6px;padding:9px 13px;border-radius:8px;font-weight:700;font-size:.93rem;white-space:nowrap}
    .nav-item>a:hover,.nav-link:hover,.nav a[aria-current="page"]{background:var(--tint);color:var(--primary)}
    .caret{width:7px;height:7px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);margin-top:-3px;opacity:.55}

    /* пункти меню без готової сторінки — видно, але не клікабельні */
    .soon{color:var(--muted);cursor:default;opacity:.65}
    .soon::after{content:"незабаром";margin-left:7px;font-size:.62rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--sky);background:var(--tint);border-radius:20px;padding:2px 7px;vertical-align:1px}
    .col li .soon::after,.sheet .soon::after{margin-left:8px}

    /* mega dropdown */
    .dd{position:absolute;top:100%;left:0;margin-top:6px;z-index:60;opacity:0;visibility:hidden;transform:translateY(6px);transition:.15s}
    .nav-item:hover .dd,.nav-item:focus-within .dd{opacity:1;visibility:visible;transform:none}
    .panel{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 30px 60px -24px rgba(14,21,51,.4);padding:26px}
    .panel-grid{display:grid;gap:26px 34px}
    .pg-2{grid-template-columns:repeat(2,220px)}
    .pg-3{grid-template-columns:repeat(3,220px)}
    .pg-4{grid-template-columns:repeat(4,190px)}
    .col h5{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--sky);margin:0 0 12px;font-weight:800;display:flex;align-items:center;gap:8px}
    .col h5::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--signal)}
    .col ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
    .col li a,.col li .soon{display:block;padding:7px 10px;border-radius:7px;font-size:.9rem;font-weight:600;color:#39406a}
    .col li a:hover{background:var(--tint);color:var(--primary)}
    .col li .soon{color:var(--muted)}
    .panel-feature{background:var(--grad-dark);color:#fff;border-radius:14px;padding:20px;display:flex;flex-direction:column;justify-content:space-between;height:100%}
    .panel-feature .display{font-size:1.1rem;margin-bottom:8px}
    .panel-feature p{font-size:.85rem;color:#cdd7ff;margin:0 0 16px}
    .panel-feature a{font-weight:800;color:var(--signal);font-size:.9rem;display:inline-flex;gap:7px;align-items:center}

    /* mobile toggle + drawer */
    .nav-toggle{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
    .burger{display:none;width:44px;height:44px;border:1px solid var(--line);border-radius:10px;background:#fff;cursor:pointer;align-items:center;justify-content:center}
    .burger span,.burger span::before,.burger span::after{content:"";display:block;width:20px;height:2px;background:var(--deep);border-radius:2px;position:relative}
    .burger span::before{position:absolute;top:-6px}
    .burger span::after{position:absolute;top:6px}
    .drawer{position:fixed;inset:0;z-index:80;visibility:hidden}
    .drawer .scrim{position:absolute;inset:0;background:rgba(14,21,51,.5);opacity:0;transition:.25s}
    .drawer .sheet{position:absolute;top:0;right:0;height:100%;width:min(86vw,360px);background:#fff;transform:translateX(100%);transition:transform .28s;overflow-y:auto;padding:18px}
    .nav-toggle:checked ~ .drawer{visibility:visible}
    .nav-toggle:checked ~ .drawer .scrim{opacity:1}
    .nav-toggle:checked ~ .drawer .sheet{transform:none}
    .sheet details{border-bottom:1px solid var(--line)}
    .sheet summary{list-style:none;cursor:pointer;padding:14px 6px;font-weight:800;color:var(--deep);display:flex;justify-content:space-between;align-items:center}
    .sheet summary::-webkit-details-marker{display:none}
    .sheet summary::after{content:"";width:8px;height:8px;border-right:2px solid var(--sky);border-bottom:2px solid var(--sky);transform:rotate(45deg);transition:.2s}
    .sheet details[open] summary::after{transform:rotate(-135deg)}
    .sheet .sub{padding:0 6px 12px}
    .sheet .sub .grp{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--sky);font-weight:800;margin:12px 4px 4px}
    .sheet .sub .grp:first-child{margin-top:4px}
    .sheet .sub a,.sheet .sub .soon{display:block;padding:9px 10px;border-radius:8px;font-weight:600;font-size:.92rem;color:#39406a}
    .sheet .m-link{display:block;padding:14px 6px;font-weight:800;color:var(--deep);border-bottom:1px solid var(--line)}
    .sheet .sub .soon{color:var(--muted)}
    .sheet .btn{width:100%;justify-content:center;margin-top:16px}

    .foot{background:var(--deep);color:#c4cdf5;padding:48px 0;margin-top:60px}
    .foot .display{color:var(--signal);font-size:1.3rem;margin-bottom:8px}

    @media(max-width:820px){
      .nav,.cta-desktop{display:none}
      .burger{display:inline-flex}
    }
    @media(min-width:821px){
      .burger,.drawer{display:none}
    }
  </style>
</body>
</html>
