---
// DepartmentCard.astro — один шаблон картки. Множиться по даних, не копіюється руками.
const { kind, name, desc, tags = [], url = "#", badge, type = "dept", labs = [] } = Astro.props;
const hasLink = url && url !== "#";
---
<article class={`card is-${type}`} data-type={type}>
  {badge && <span class="badge">{badge}</span>}
  <div class="kind">{kind}</div>
  <h3>{name}</h3>
  {desc && <p>{desc}</p>}
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((t) => <span>{t}</span>)}
    </div>
  )}
  {labs.length > 0 && (
    <ul class="labs">
      {labs.map((lab) => <li>{lab.name}</li>)}
    </ul>
  )}
  {hasLink && <a class="lnk" href={url} target="_blank" rel="noopener">Детальніше →</a>}
</article>

<style>
  .card{position:relative;border:1px solid var(--line);border-radius:var(--radius);padding:24px;background:#fff;
    transition:transform .2s,box-shadow .2s,border-color .2s;display:flex;flex-direction:column}
  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:transparent}
  .card:has(.badge){border-color:var(--signal);background:linear-gradient(180deg,var(--tint) 0%,#fff 70px)}
  .badge{position:absolute;top:18px;right:18px;font-size:.64rem;font-weight:800;letter-spacing:.08em;
    text-transform:uppercase;color:var(--ink);background:var(--signal);padding:5px 10px;border-radius:20px}
  .kind{font-size:.66rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--sky);padding-right:110px}
  .card.is-center{border-left:4px solid var(--primary)}
  .card.is-center .kind{color:var(--primary)}
  .card.is-lab{border-left:4px solid var(--deep)}
  .card.is-lab .kind{color:var(--deep)}
  h3{color:var(--deep);font-size:1.08rem;margin:6px 0 10px}
  p{color:var(--muted);font-size:.9rem;margin:0 0 14px}
  .tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
  .tags span{font-size:.7rem;font-weight:700;color:#39406a;background:var(--tint);
    border:1px solid var(--line);padding:4px 9px;border-radius:20px}
  .labs{list-style:none;margin:0 0 16px;padding:10px 0 0;border-top:1px dashed var(--line);
    display:flex;flex-direction:column;gap:6px}
  .labs li{font-size:.82rem;color:#39406a;padding-left:16px;position:relative}
  .labs li::before{content:"";position:absolute;left:0;top:.5em;width:5px;height:5px;border-radius:50%;background:var(--sky)}
  .lnk{margin-top:auto;font-weight:800;font-size:.86rem;color:var(--primary)}
</style>
