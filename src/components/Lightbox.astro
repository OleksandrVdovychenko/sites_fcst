---
// Lightbox.astro — повноекранний перегляд фото для сторінок лабораторій.
// Підключається одним тегом; сам знаходить .hero-frame та .gallery figure на сторінці
// й відкриває їхні <img> у нативному <dialog> з навігацією ‹ › та підписом (alt).
---
<dialog id="lightbox" class="lightbox" aria-label="Перегляд фото">
  <button type="button" class="lb-close" aria-label="Закрити">✕</button>
  <div class="lb-stage">
    <button type="button" class="lb-prev" aria-label="Попереднє фото">‹</button>
    <img id="lightbox-img" alt="" />
    <button type="button" class="lb-next" aria-label="Наступне фото">›</button>
  </div>
  <div class="lb-meta">
    <p id="lightbox-caption"></p>
    <span id="lightbox-counter"></span>
  </div>
</dialog>

<style>
  :global(.hero-frame),
  :global(.gallery figure) {
    cursor: zoom-in;
  }
  :global(.hero-frame:hover img),
  :global(.gallery figure:hover img) {
    transform: scale(1.03);
  }
  :global(.hero-frame img),
  :global(.gallery img) {
    transition: transform .25s;
  }

  .lightbox {
    border: none; padding: 0; background: transparent; margin: auto;
    max-width: 92vw; max-height: 92vh;
  }
  .lightbox[open] {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .lightbox::backdrop { background: rgba(14, 21, 51, .92); }

  .lb-stage {
    position: relative; display: flex; align-items: center; justify-content: center;
    max-width: 92vw; max-height: 78vh; touch-action: none;
  }
  #lightbox-img {
    max-width: 92vw; max-height: 78vh; object-fit: contain;
    border-radius: var(--radius-sm); display: block;
  }
  .lb-meta { text-align: center; max-width: 70ch; }
  #lightbox-caption { margin: 0; color: #fff; font-size: .9rem; opacity: .9; }
  #lightbox-counter { display: block; margin-top: 4px; color: #9aa6d6; font-size: .78rem; font-weight: 700; }

  /* all:unset живе в тому самому селекторі, що й розмір/позиція — інакше
     Astro дописує data-astro-cid до кожного правила окремо, і винесений
     в окреме правило `all:unset` (нижчої специфічності) все одно переміг би
     через додану ним же специфічність — саме так кнопки стискались у смужку. */
  .lb-close, .lb-prev, .lb-next {
    all: unset; cursor: pointer; color: #fff; box-sizing: border-box;
    display: flex; align-items: center; justify-content: center; border-radius: 50%;
  }
  .lb-close {
    position: fixed; top: 20px; right: 20px;
    width: 44px; height: 44px; background: rgba(14, 21, 51, .55);
    font-size: 1.4rem; line-height: 1; transition: background .15s;
  }
  .lb-close:hover { background: rgba(14, 21, 51, .85); }

  /* prev/next сидять на самій сцені (не на viewport) — так вони завжди точно
     впритул до фото, навіть коли мобільний браузер змінює висоту viewport
     через рядок адреси (через що position:fixed;top:50% "їде" не туди). */
  .lb-prev, .lb-next {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 1;
    width: 52px; height: 52px; background: rgba(14, 21, 51, .65);
    box-shadow: 0 4px 16px rgba(0,0,0,.35);
    font-size: 1.6rem; line-height: 1; transition: background .15s, transform .15s;
  }
  .lb-prev:hover, .lb-next:hover { background: rgba(14, 21, 51, .9); }
  .lb-prev:active, .lb-next:active { transform: translateY(-50%) scale(.92); }
  .lb-prev { left: -8px; }
  .lb-next { right: -8px; }

  @media (max-width: 600px) {
    .lb-prev, .lb-next { width: 48px; height: 48px; font-size: 1.5rem; background: rgba(14, 21, 51, .75); }
    .lb-prev { left: 4px; }
    .lb-next { right: 4px; }
    .lb-close { top: 10px; right: 10px; }
  }
</style>

<script>
  function initLightbox() {
    const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
    if (!dialog) return;
    const imgEl = document.getElementById("lightbox-img") as HTMLImageElement;
    const captionEl = document.getElementById("lightbox-caption")!;
    const counterEl = document.getElementById("lightbox-counter")!;
    const stage = dialog.querySelector(".lb-stage") as HTMLDivElement;
    const prevBtn = dialog.querySelector(".lb-prev") as HTMLButtonElement;
    const nextBtn = dialog.querySelector(".lb-next") as HTMLButtonElement;
    const closeBtn = dialog.querySelector(".lb-close") as HTMLButtonElement;

    const groups = Array.from(document.querySelectorAll<HTMLElement>(".hero-frame, .gallery figure"));
    const items = groups
      .map((el) => el.querySelector("img"))
      .filter((el): el is HTMLImageElement => !!el);
    if (!items.length) return;

    let index = 0;

    function render() {
      const img = items[index];
      imgEl.src = img.currentSrc || img.src;
      imgEl.alt = img.alt;
      captionEl.textContent = img.alt;
      counterEl.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : "";
      prevBtn.hidden = nextBtn.hidden = items.length < 2;
    }

    function show(i: number) {
      index = (i + items.length) % items.length;
      render();
    }

    function open(i: number) {
      show(i);
      document.body.style.overflow = "hidden";
      dialog!.showModal();
    }

    groups.forEach((el, i) => {
      if (!items[i]) return;
      el.tabIndex = 0;
      el.setAttribute("role", "button");
      el.setAttribute("aria-label", "Переглянути фото у повному розмірі");
      el.addEventListener("click", () => open(i));
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open(i);
        }
      });
    });

    prevBtn.addEventListener("click", () => show(index - 1));
    nextBtn.addEventListener("click", () => show(index + 1));
    closeBtn.addEventListener("click", () => dialog!.close());

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog!.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(index + 1);
      if (e.key === "ArrowLeft") show(index - 1);
    });

    let touchStartX = 0;
    let touchStartY = 0;
    stage.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        show(index + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });

    // MutationObserver замість події "close" — деякі рушії ненадійно її диспетчерять,
    // а атрибут open дialog оновлюється синхронно завжди, незалежно від того, як діалог закрили.
    new MutationObserver(() => {
      if (!dialog!.open) document.body.style.overflow = "";
    }).observe(dialog, { attributes: true, attributeFilter: ["open"] });
  }

  initLightbox();
</script>
